number {
      either 'one' or 'two' or 'three' or one of '369'
}

char {
      one of '!.'
}

match {
      either number or char
}

tests:
      "asdasdsadasonesaagsdgs",
      "one two three",
      "two three",
      "three",
      "vxvcxv",
      "vxvcxv!",
      "vxvcxv.ad",
      "asd.",
      "144555",
      "1443",
      "54456",
      "9"

target:
      match