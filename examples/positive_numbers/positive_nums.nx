minus_sign {
      negative lookbehind '-' 
}

number {
      digit repeat 1 or more times
}

positive_number {
      boundary 
      minus_sign
      number
}
      
flags:
      global match,
      multiline

tests:
"10 -25 -35 45
-150 25 -35 -147
8 -88 -888 -8888
-3 -33 -333 -333"

engine:
      python

target:
      positive_number