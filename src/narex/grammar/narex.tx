
Anchor:
    clauses+=Clause 
    optional=Optional
    result=[Clause] // Maybe safe-scoping? Yeah it is important especially later on, I can do it easily by intercepting objects, smth like that I had it in the example related to the state machine.
;

Clause:
    name=ID ':' 
        clauses*=Clause 
        inlineRules+=InlineRule['\n']
;

InlineRule:
    rules+=Rule
;

Rule:
    maybe?=Maybe (rule=OneOf | Letter | rule=Either | rule=Repeat )
;

Maybe:
    'maybe'
;

OneOf:
    'one' 'of' STRING
;

Letter:
    'letter'
;
Either:
    'either' alternatives=Rule ('or' alternatives=Rule)+
;

;
Digit:
    'digit' (between=Between)?
;

Between:
    'between' start=INT 'and' end=INT
;

Repeat:
    'repeat' times=Times more?=OrMore 'times'
;

Times:
    '0' | '1' | INT
;

OrMore:
    'or' 'more'
;
Optional:
    ((tests=Tests)? (flavor=Flavor)?)#
;

Tests:
    'tests:' 
        sample*=STRING
;

Flavor:
    'flavor:'
        'python'
;
