import re

text = ""   # empty
regex = {{repr_regex}}

{% if model.optional and model.optional.flags and model.optional.flags.values and "globalmatch" in model.optional.flags.values -%}
match_strings = re.findall(
    regex, 
    text{% if flags != '' %}, 
    flags={{flags}}
    {%- endif %}
)
match_objects = re.finditer(
    regex, 
    text{% if flags != '' %}, 
    flags={{flags}}
    {%- endif %}
)
{% else %}
match_object = re.search(
    regex, 
    text{% if flags != '' %}, 
    flags={{flags}}
    {%- endif %}
)
{% endif %}